# 「定时 @ 提醒」机器人配置模板
#
# 使用方式：复制到仓库外的私密文件，填入真实值，并收紧权限：
#   mkdir -p ~/.config/qq-mention-bot
#   cp mention_bot.env.example ~/.config/qq-mention-bot/env.sh
#   chmod 600 ~/.config/qq-mention-bot/env.sh
#
# 然后启动（run_mention_bot.sh 会自动加载该文件）：
#   ./run_mention_bot.sh

# 机器人自己的 QQ 号（必填）
MENTION_BOT_QQ=<BOT_QQ>

# 只监听这个群（必填）
MENTION_GROUP_ID=<GROUP_ID>

# 只有这个 QQ 号发的命令才生效（必填）
MENTION_ALLOWED_USER_ID=<ALLOWED_USER_QQ>

# Webhook 监听地址（NapCat 的事件上报地址要指向这里）
MENTION_HOST=127.0.0.1
MENTION_PORT=18081

# 该 QQ 号自己的 OneBot HTTP API（注意：不能和原机器人的 3000 端口冲突）
MENTION_NAPCAT_API_BASE=http://127.0.0.1:3001
MENTION_NAPCAT_ACCESS_TOKEN=

# 间隔限制：最小 5 秒，最大 24 小时，防止刷屏 / 触发风控
MENTION_MIN_INTERVAL=5
MENTION_MAX_INTERVAL=86400

# 每次 @ 后面附带的内容，留空则只 @ 人
MENTION_TEXT=🔔
